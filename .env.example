# ─────────────────────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────────────────────
# Canonical URL, no trailing slash. Used for canonicals, OG tags and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Where the "Login" nav link sends existing clients (your GHL client portal).
NEXT_PUBLIC_LOGIN_URL=https://app.gohighlevel.com/

# 'numbers' shows the dollar amounts in src/content/pricing.ts
# 'custom'  hides them and shows "Custom Pricing" on every tier
NEXT_PUBLIC_PRICING_MODE=numbers

# Testimonials stay hidden until this is 'true' AND src/content/testimonials.ts
# has real, permission-granted quotes in it.
NEXT_PUBLIC_SHOW_TESTIMONIALS=false

# ─────────────────────────────────────────────────────────────────────────────
# GOHIGHLEVEL — SERVER SIDE ONLY (never prefix these with NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────────────
# OPTION A (recommended, simplest): Inbound Webhook trigger URL.
# GHL → Automation → Workflows → new workflow → trigger "Inbound Webhook" → copy URL.
GHL_WEBHOOK_URL=

# OPTION B: direct API. GHL → Settings → Private Integrations → create a token
# with contacts.write and opportunities.write scopes.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Optional: create a pipeline opportunity as well as a contact (Option B only).
# Find these in the URL when viewing the pipeline in GHL.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# CALENDAR EMBED (public — this one is safe in the browser)
# ─────────────────────────────────────────────────────────────────────────────
# GHL → Calendars → your calendar → Share → copy the embed link, e.g.
# https://api.leadconnectorhq.com/widget/booking/XXXXXXXXXXXX
NEXT_PUBLIC_GHL_CALENDAR_URL=

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS (all optional — each script only loads when its ID is present)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=          # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=              # e.g. 123456789012345
NEXT_PUBLIC_GOOGLE_ADS_ID=              # e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL= # e.g. AbCdEfGhIjKlMnOp
NEXT_PUBLIC_GHL_TRACKING_ID=            # GHL location ID for its tracking script
